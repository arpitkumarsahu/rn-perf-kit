{
  "name": "rn-perf-kit",
  "version": "0.1.0",
  "description": "Deep performance profiling toolkit for React Native apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./navigation": "./src/navigation.ts",
    "./adapters": "./src/adapters.ts"
  },
  "scripts": { "typecheck": "tsc --noEmit", "lint": "eslint src/" },
  "peerDependencies": { "react": ">=18.0.0", "react-native": ">=0.73.0" },
  "devDependencies": { "typescript": "^5.3.0", "@types/react": "^18.0.0" },
  "dependencies": {
    "@rn-perf-kit/core": "workspace:*",
    "@rn-perf-kit/native": "workspace:*",
    "@rn-perf-kit/react": "workspace:*",
    "@rn-perf-kit/navigation": "workspace:*",
    "@rn-perf-kit/adapters": "workspace:*",
    "@rn-perf-kit/analyzers": "workspace:*",
    "@rn-perf-kit/overlay": "workspace:*",
    "@rn-perf-kit/reporters": "workspace:*"
  }
}
