{
  "name": "rn-perf-kit",
  "version": "0.1.5",
  "description": "Deep performance profiling toolkit for React Native apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./navigation": "./src/navigation.ts",
    "./adapters": "./src/adapters.ts",
    "./expo-router": "./src/navigation.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "android",
    "ios",
    "RnPerfKit.podspec",
    "react-native.config.js",
    "!android/build",
    "!ios/build"
  ],
  "codegenConfig": {
    "name": "RnPerfKitSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnperfkit"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/react": "^18.0.0"
  },
  "dependencies": {
    "@rn-perf-kit/core": "^0.1.5",
    "@rn-perf-kit/native": "^0.1.5",
    "@rn-perf-kit/react": "^0.1.5",
    "@rn-perf-kit/navigation": "^0.1.5",
    "@rn-perf-kit/adapters": "^0.1.5",
    "@rn-perf-kit/analyzers": "^0.1.5",
    "@rn-perf-kit/overlay": "^0.1.5",
    "@rn-perf-kit/reporters": "^0.1.5"
  },
  "author": "Arpit Kumar Sahu <aarpitkumarsahu99@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpitkumarsahu/rn-perf-kit.git",
    "directory": "packages/perf-provider"
  },
  "bugs": {
    "url": "https://github.com/arpitkumarsahu/rn-perf-kit/issues"
  },
  "homepage": "https://github.com/arpitkumarsahu/rn-perf-kit#readme",
  "keywords": [
    "react-native",
    "react-native-performance",
    "performance",
    "profiling",
    "profiler",
    "jank",
    "fps",
    "dropped-frames",
    "android",
    "ios",
    "budget-android",
    "react-navigation",
    "navigation",
    "expo-router",
    "re-render",
    "wasted-renders",
    "fiber-devtools",
    "turbomodule",
    "fabric",
    "new-architecture",
    "hud",
    "overlay",
    "perfetto"
  ]
}
